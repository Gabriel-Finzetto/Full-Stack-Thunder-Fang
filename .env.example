# Configuração pública. As chaves de servidor abaixo nunca recebem prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente na máquina local: permite cotações sem o limitador compartilhado.
# A fonte local do catálogo exige também ausência das duas variáveis públicas do Supabase.
# O modo é recusado na Vercel ou com origem/solicitação fora de loopback.
BACKEND_LOCAL_MODE=true
# Gerar ao menos 32 bytes de entropia. Não versionar o valor real; manter estável entre instâncias.
BACKEND_REVIEW_SECRET=

# A chave secreta é exclusiva do servidor; não expor em componentes ou variáveis públicas.
SUPABASE_SECRET_KEY=
# Alternativa legada ao campo acima, se o projeto ainda usar service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Obrigatórios apenas nos builds públicos da Vercel. Preencha ambos, diferentes,
# em Production e Preview. A URL Supabase deve corresponder ao ambiente do build.
SUPABASE_PRODUCTION_PROJECT_REF=
SUPABASE_PREVIEW_PROJECT_REF=

# Contato: transporte transacional via API Brevo; destinatário fixo no servidor.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Thunder Fang
# O SMTP de autenticação continua configurado no Supabase/Brevo, fora do repositório.
